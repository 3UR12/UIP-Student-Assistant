{
  "manifest_version": 3,
  "name": "UIP Student Assistant",
  "version": "0.5.0",
  "description": "Automated Multi-Module Feedback Processor for Moodle UIP.",
  "permissions": ["storage", "alarms"],
  "background": { "service_worker": "background/workflow-service.js" },
  "host_permissions": ["https://moodle.uip.edu.pa/*"],
  "action": { "default_title": "UIP Student Assistant" },
  "content_scripts": [
    {
      "matches": ["https://moodle.uip.edu.pa/*"],
      "js": [
        "core/state.js",
        "core/moodle.js",
        "core/courses.js",
        "core/modules.js",
        "core/activities.js",
        "core/feedback.js",
        "core/feedback-form.js",
        "core/submission.js",
        "core/navigation.js",
        "core/workflow-navigation.js",
        "core/workflow-state.js",
        "core/sanitize.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
